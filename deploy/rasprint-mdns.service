[Unit]
Description=RasPrint AP multicast DNS alias
After=NetworkManager.service avahi-daemon.service
Wants=avahi-daemon.service

[Service]
Type=exec
User=rasprint-proxy
Group=rasprint-proxy
WorkingDirectory=/opt/rasprint
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m deploy.mdns
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
